# ---------------------------------------------------------------------------
# NexusGuard — example environment. Copy to backend/.env and fill in.
# The web app reads frontend/.env.local (see frontend/.env.example).
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development          # development | production
APP_URL=http://localhost:3000    # the dashboard; the only origin CORS allows
API_URL=http://localhost:8000    # used to build the OAuth redirect URI

# --- Database ----------------------------------------------------------------
# SQLite by default. The API and the bot must point at the same database.
# PostgreSQL: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nexusguard
DATABASE_URL=sqlite:///./nexusguard.db

# --- Sessions ----------------------------------------------------------------
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
SESSION_TTL_MINUTES=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Discord (leave empty to run the dashboard in demo mode only) ---------------
# https://discord.com/developers/applications -> your app
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Register this exact URL under OAuth2 -> Redirects:
#   http://localhost:8000/api/auth/callback
# How long a login's guild-permission snapshot is trusted before re-login.
GUILD_ACCESS_TTL_MINUTES=720

# --- Demo mode -----------------------------------------------------------------
# The simulated guilds and the "Explore the demo" login. They never mix with
# real guilds: demo sessions can only see simulated guilds, and the other way round.
DEMO_ENABLED=true
# Feed the demo guild a new simulated incident every N seconds (0 = off).
DEMO_SIMULATOR_INTERVAL=25
